# --- 실행 환경 / 의존성 (setup 스크립트와 lock 파일로 재생성) ---
.runtime/
.venv/
node_modules/

# --- 빌드 결과 / 캐시 ---
dist/
__pycache__/
.pytest_cache/
*.pyc

# --- 실험 / 임시 산출물 (용량 큼, 로컬에만 보관) ---
tmp/
research/
list.txt

# --- 로컬 설정 / 시험 데이터 ---
runtime.local.json
*.piipost

# --- 공개 저장소에는 실행 코드·필수 설치 자료·예시 12종만 포함 ---
/local-only/
/AGENTS.md
/docs/
/tests/
/validation/
/scripts/check/
/scripts/evaluate/
/examples/documents/
/examples/formats/*.md
/examples/formats/*.json

# --- 이전 경로의 열린 문서와 개발 산출물은 로컬 전용 ---
/output/
/reports/
/report_qa/
/test/

# --- 대용량 바이너리 안전망 (GitHub 파일당 100MB 제한) ---
*.safetensors
*.onnx
*.msi
*.dll
*.zip

# --- 설치판 빌드 산출물 / 로컬 도구 ---
.tools/
backend/HwpText.class
installer/out/
installer/stage/
