# Store text as LF in the repository; let Git convert for the platform on checkout.
* text=auto

# Shell scripts must stay LF on every platform (CRLF breaks "#!/usr/bin/env bash").
*.sh text eol=lf

# The Windows launcher is UTF-16; never convert it.
*.vbs -text

# Audit fixtures are hashed as bytes, including CSV/TSV line endings and CP949.
validation/fixtures/** -text whitespace=cr-at-eol
examples/formats/files/** -text whitespace=cr-at-eol

# Binary files (documents, images, archives, model weights).
*.docx binary
*.pptx binary
*.xlsx binary
*.hwpx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.safetensors binary
*.onnx binary

# Preserve synthetic example input bytes across Windows and Linux.
examples/documents/*.docx binary
examples/documents/*.pdf binary
examples/documents/*.xlsx binary
*.hwp binary
